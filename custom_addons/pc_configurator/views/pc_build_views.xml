<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_pc_build" model="ir.actions.act_window">
        <field name="name">Configurador de PCs</field>
        <field name="res_model">pc.build</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_pc_build_tree" model="ir.ui.view">
        <field name="name">pc.build.tree</field>
        <field name="model">pc.build</field>
        <field name="arch" type="xml">
            <tree string="Configuraciones">
                <field name="name"/>
                <field name="client_id"/>
                <field name="total_price" sum="Total Presupuestado"/>
            </tree>
        </field>
    </record>

    <record id="view_pc_build_form" model="ir.ui.view">
        <field name="name">pc.build.form</field>
        <field name="model">pc.build</field>
        <field name="arch" type="xml">
            <form string="Configuración de PC">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Ej. PC Gaming Master Race"/>
                        </h1>
                    </div>
                    <group>
                        <field name="client_id"/>
                    </group>
                    
                    <notebook>
                        <page string="Componentes de Hardware" name="hardware_components">
                            <group>
                                <group string="Núcleo del Sistema">
                                    <field name="cpu_id" options="{'no_create': True}"/>
                                    <field name="motherboard_id" options="{'no_create': True}"/>
                                    <field name="ram_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Expansión y Energía">
                                    <field name="gpu_id" options="{'no_create': True}"/>
                                    <field name="storage_id" options="{'no_create': True}"/>
                                    <field name="case_id" options="{'no_create': True}"/>
                                    <field name="psu_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                            
                            <group>
                                <group string="Resumen Económico">
                                    <field name="total_price" widget="monetary" decoration-bf="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>